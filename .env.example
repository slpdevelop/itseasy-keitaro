# Itseasy Keitaro — конфигурация.
# Скопируйте в .env (в корне проекта) и заполните значения:
#   cp .env.example .env
# Файл .env содержит секреты и не должен попадать в Git.

# ---------------------------------------------------------------------------
# Приложение
# ---------------------------------------------------------------------------
# development -> live reload (uvicorn --reload, Vite dev server), Swagger на /docs
# production  -> статичная сборка (nginx + uvicorn без --reload), /docs отключён
# Для Docker допустимы только development и production.
ENV=development
DEBUG=False
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Keitaro API (обязательно)
# ---------------------------------------------------------------------------
# Адрес Keitaro, обязательно с http:// или https://
KEITARO_BASE_URL=https://your-keitaro-instance.com
# API-токен администратора Keitaro (храните в секрете)
KEITARO_API_TOKEN=your_api_token_here
KEITARO_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Параметры создания кампаний
# ---------------------------------------------------------------------------
# Приложение создаёт кампании с этим префиксом и показывает в списке только их.
CAMPAIGN_NAME_PREFIX=test_zhestkov_
CAMPAIGN_GROUP_ID=10332
CAMPAIGN_DOMAIN_ID=1813
CAMPAIGN_TRAFFIC_SOURCE_ID=836

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
# Обязательно задайте свой пароль. Используйте буквы и цифры: пароль подставляется в URL.
# ВАЖНО: пароль применяется при первом создании тома БД. Если меняете его позже,
# выполните `docker compose down -v` (это удалит данные БД).
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=keitaro_app
# Порт БД на хосте (внутри Docker всегда 5432). Измените, если 5432 занят.
POSTGRES_PORT=5432

# DSN нужен только для запуска backend БЕЗ Docker (хост — localhost).
# В Docker Compose собирает DSN сам из переменных POSTGRES_* выше и игнорирует это значение.
# Если меняете пароль или порт выше, обновите и эту строку.
POSTGRES_DB_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/keitaro_app

# ---------------------------------------------------------------------------
# CORS (нужно только при запуске frontend без Docker; в Docker запросы идут через nginx/Vite proxy)
# Формат — JSON-массив.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=False
