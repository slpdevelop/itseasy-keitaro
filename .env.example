# Itseasy Keitaro — Пример конфигурации
# Скопируйте этот файл в .env и заполните свои значения

## Keitaro API настройки

# Адрес вашего экземпляра Keitaro (без http:// или https://)
# Пример: keitaro.example.com
KEITARO_BASE_URL=

# API токен Keitaro (сохраняйте в секретах!)
# Получите на странице настроек Keitaro
KEITARO_API_TOKEN=

## База данных (опционально, для локальных данных)

# Отключить использование PostgreSQL (использовать только mock-провайдер)
# Для реальной работы: установите false
USE_POSTGRESQL=false

# Настройки подключения к PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=keitaro_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

## Логирование

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_LOG_LEVEL=INFO

## Окружение

# окружение: development, staging, production
APP_ENV=development
