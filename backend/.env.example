# Keitaro Campaign Manager - Environment Configuration
# DO NOT COMMIT THIS FILE (excluded from Git via .gitignore)
# Copy to backend/.env and fill in your own values before running with Docker.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Keitaro API (required by the application)
# ---------------------------------------------------------------------------
# Base URL of your Keitaro instance, must start with http:// or https://
KEITARO_BASE_URL=https://your-keitaro-instance.com
# API token for authenticating Keitaro admin API requests (keep secret!)
KEITARO_API_TOKEN=your_api_token_here
KEITARO_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Campaign creation defaults (from Settings)
# ---------------------------------------------------------------------------
CAMPAIGN_NAME_PREFIX=test_zhestkov_
CAMPAIGN_GROUP_ID=10332
CAMPAIGN_DOMAIN_ID=1813
CAMPAIGN_TRAFFIC_SOURCE_ID=836

# ---------------------------------------------------------------------------
# Local PostgreSQL storage (used when USE_POSTGRESQL=True)
# ---------------------------------------------------------------------------
USE_POSTGRESQL=True
# DSN used by the application and Alembic. In Docker Compose the host is the
# "postgres" service name and the password comes from POSTGRES_PASSWORD below.
POSTGRES_DB_URL=postgresql+asyncpg://postgres:keitaro_local_dev@postgres:5432/keitaro_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=keitaro_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=keitaro_local_dev

# ---------------------------------------------------------------------------
# CORS (adjust to the origin you open the frontend on)
# pydantic-settings parses list[str] env vars as JSON, so a JSON array is used.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=False
