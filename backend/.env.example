# Keitaro Campaign Manager - Configuration Example
# Copy this file to .env and fill in your values

# Application settings
APP_NAME="Keitaro Campaign Manager"
APP_VERSION="0.1.0"
ENV="development"  # development, staging, production
DEBUG=False

# Keitaro API settings (CRITICAL SECURITY - NEVER COMMIT REAL VALUES)
KEITARO_BASE_URL="https://api.keitaro.example.com"
KEITARO_API_TOKEN=""  # Your Keitaro API token

# PostgreSQL settings (optional) (CRITICAL SECURITY - NEVER COMMIT REAL PASSWORDS)
# Local database runs via Docker Compose from backend/: docker compose up -d
# POSTGRES_PASSWORD must be set here and is used both by Docker Compose and the app.
USE_POSTGRESQL=False
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DATABASE="keitaro_app"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""  # Your database password (required when USE_POSTGRESQL=True)

# Logging
LOG_LEVEL="INFO"
