# Keitaro Campaign Manager - Environment Configuration
# DO NOT COMMIT THIS FILE

# Application settings
ENV="development"
DEBUG=True


KEITARO_BASE_URL=""
KEITARO_API_TOKEN=""  # Your Keitaro API token
KEITARO_TIMEOUT_SECONDS=60

# PostgreSQL settings (local development via Docker Compose: docker compose up -d)
POSTGRES_DB_URL=postgresql+asyncpg://postgres:keitaro_local_dev@localhost:5432/keitaro_app

# Docker Compose PostgreSQL (local development)
USE_POSTGRESQL_DOCKER=True

ALLOWED_HOSTS='["http://localhost:5173","https://app.example.com"]'

# Logging
LOG_LEVEL="DEBUG"
